generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  email           String    @unique
  emailVerifiedAt DateTime?

  name         String?
  status       UserStatus @default(PENDING_VERIFICATION)
  passwordHash String?

  accounts Account[] @relation("owner")

  createdAt DateTime @default(now())
}

model Account {
  id Int @id @default(autoincrement())

  type          AccountType
  currency      Currency    @relation(fields: [currency_code], references: [code])
  currency_code String

  user_id Int?
  user    User? @relation("owner", fields: [user_id], references: [id])

  entries Entry[]
}

model Currency {
  code     String    @id @db.Char(3)
  name     String
  symbol   String
  accounts Account[]
}

model Transaction {
  id              Int             @id @default(autoincrement())
  idempotency_key String          @unique
  type            TransactionType
  date            DateTime        @default(now())
  entries         Entry[]
  rate            Decimal         @default(1) @db.Decimal(20, 12)
}

model Entry {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  transaction    Transaction @relation(fields: [transaction_id], references: [id])
  account_id     Int
  account        Account     @relation(fields: [account_id], references: [id])
  amount         Int

  @@index([account_id])
}

// ENUMS
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  TRANSFER
  TOP_UP
  WITHDRAWAL
}

enum AccountType {
  STANDARD
  SAVING
  STUDENT
  BUSINESS
}
